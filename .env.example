# Optional: Anthropic API key. Leave empty to use the Claude Code login on this
# machine (run `claude` once and sign in with your subscription). If set, the API
# key is used instead of the subscription. Never commit the real value.
ANTHROPIC_API_KEY=

# Shared secret the MCP client must send as "Authorization: Bearer <token>". Use a long random string.
BRIDGE_TOKEN=

# Folder Claude Code is allowed to work in. Sessions cannot start outside it.
BRIDGE_WORKDIR=

# Optional: model for Claude Code sessions. Leave empty for Claude Code's default.
BRIDGE_MODEL=

# Optional: maximum agent turns per session (default 40).
BRIDGE_MAX_TURNS=

# Optional: maximum spend per session in USD (default 2).
BRIDGE_MAX_BUDGET_USD=

# Optional: port to listen on (default 8080).
PORT=
